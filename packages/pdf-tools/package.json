{
  "name": "@theasset/pdf-tools",
  "type": "module",
  "main": "./node/index.ts",
  "browser": "./web/index.ts",
  "exports": {
    ".": {
      "node": "./node/index.ts",
      "default": "./web/index.ts"
    },
    "./types": {
      "node": "./web/types.ts",
      "default": "./web/types.ts"
    }
  },
  "version": "0.1.0",
  "scripts": {
    "build:web": "wasm-pack build --release --target web --out-dir ./web/output && yarn clean:output",
    "build:node": "wasm-pack build --release --target web --out-dir ./node/output && yarn clean:output",
    "clean:output": "node ./scripts/clean-output.cjs",
    "test": "jest -c jest.config.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.5"
  },
  "dependencies": {
    "@theasset/utilities": "*"
  }
}
